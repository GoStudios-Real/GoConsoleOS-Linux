[Name]
Name=GoConsoleOS
Comment=GoStudios On-Screen Keyboard Theme

[Background]
border_color=#0066FF
border_width=2
fill_color=#1E2D42
fill_color_prelight=#253555
fill_color_active=#0066FF
fill_color_insensitive=#141A2E

[Font]
color=#F0F0FF
face=Sans Bold
size=16

[Key]
background_color=#1E2D42
background_color_prelight=#253555
background_color_active=#0066FF
background_color_insensitive=#141A2E
border_color=#2A3555
border_width=1
font_color=#F0F0FF
font_color_insensitive=#4A4A6A
radius=8

[KeySpecial]
background_color=#0D0D14
background_color_prelight=#141A2E
background_color_active=#0066FF
border_color=#0066FF
font_color=#0066FF

[KeyReturn]
background_color=#0066FF
background_color_prelight=#3385FF
background_color_active=#0044CC
font_color=#FFFFFF
